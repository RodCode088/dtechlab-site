# Local practice mode. No account or external database is required.
PAYLOAD_DB_MODE=sqlite
SQLITE_URL=file:./dtechlab-cms.db

# Production mode on Render + Supabase:
# PAYLOAD_DB_MODE=postgres
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@REGION.pooler.supabase.com:5432/postgres

# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=replace-with-a-long-random-secret

NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PUBLIC_SITE_URL=https://www.dtechl.com

# Supabase > Storage > Settings > S3 Access Keys
# S3_BUCKET=dtechlab-cms
# S3_ENDPOINT=https://PROJECT_REF.supabase.co/storage/v1/s3
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=replace-with-supabase-s3-access-key
# S3_SECRET_ACCESS_KEY=replace-with-supabase-s3-secret-key
